#!/usr/bin/env php
<?php

declare(strict_types=1);

// Load autoloader
require __DIR__ . '/autoload.php';

use Koriym\XdebugMcp\XdebugRunner;
use Koriym\XdebugMcp\XdebugTracer;

// Parse command line arguments
function showHelp(string $scriptName): void {
    echo "Usage: $scriptName [--json] [--claude] [--context=TEXT] [--include-vendor=PATTERNS] -- command\n";
    echo "\n";
    echo "AI-Optimized PHP Execution Flow Tracer with Docker Support\n";
    echo "\n";
    echo "EXAMPLES:\n";
    echo "  # Local PHP execution\n";
    echo "  $scriptName --context=\"Debug login\" -- php login.php\n";
    echo "\n";
    echo "  # Docker execution\n";
    echo "  $scriptName --context=\"Docker test\" -- docker compose run --rm php php /app/script.php\n";
    echo "\n";
    echo "OPTIONS:\n";
    echo "  --json                      Output structured JSON\n";
    echo "  --claude                    Auto-analyze with Claude AI\n";
    echo "  --context=TEXT             Add contextual description\n";
    echo "  --include-vendor=PATTERNS  Include vendor packages\n";
    echo "  --help, -h                 Show this help\n";
    echo "\n";
}

// Check for help flag
if (isset($argv[1]) && ($argv[1] === '--help' || $argv[1] === '-h')) {
    showHelp($argv[0]);
    exit(0);
}

// Parse flags
$jsonOutput = in_array('--json', $argv);
$claudeAnalysis = in_array('--claude', $argv);
$context = null;
$includeVendor = null;

// Parse --context= flag
foreach ($argv as $arg) {
    if (str_starts_with($arg, '--context=')) {
        $context = substr($arg, 10);
    }
    if (str_starts_with($arg, '--include-vendor=')) {
        $includeVendor = substr($arg, 17);
    }
}

// Execute trace
try {
    $runner = new XdebugRunner($argv);
    $runner->setMode('trace');
    $runner->setContext($context);
    $runner->setIncludeVendor($includeVendor);

    $exitCode = $runner->run();

    if ($exitCode !== 0) {
        exit($exitCode);
    }

    // Get the generated trace file
    $traceFile = $runner->getLatestTraceFile();

    if ($traceFile === null) {
        fwrite(STDERR, "Error: Trace file not found\n");
        exit(1);
    }

    // Parse trace file for statistics
    $tracer = new XdebugTracer();
    $stats = $tracer->parseTraceFile($traceFile);

    if ($jsonOutput) {
        // JSON output for MCP/AI consumption
        $result = [
            'trace_file' => $traceFile,
            'total_lines' => $stats['total_lines'],
            'unique_functions' => count($stats['unique_functions']),
            'max_call_depth' => $stats['max_depth'],
            'database_queries' => $stats['db_operations'],
            'specification' => 'https://xdebug.org/docs/trace'
        ];

        if ($context !== null) {
            $result['analysis_context'] = $context;
        }

        echo json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    } else {
        // Simple trace metadata for CLI
        echo "Trace complete: $traceFile\n";
        if ($context !== null) {
            echo "Context: $context\n";
        }
        echo "{$stats['total_lines']} lines generated\n";

        $uniqueFunctionCount = count($stats['unique_functions']);
        echo "$uniqueFunctionCount unique functions\n";
        echo "{$stats['max_depth']} max call depth\n";

        if ($stats['db_operations'] > 0) {
            echo "{$stats['db_operations']} database queries\n";
        }

        echo "\nclaude \"Analyze $traceFile\"\n";
    }

    if ($claudeAnalysis) {
        $tracer->analyzeWithClaude($traceFile);
    }

} catch (Exception $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    exit(1);
}

exit(0);
