#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Environment Check and Installation Helper
 * 
 * Checks Xdebug environment and optionally configures MCP integration
 */

// Load XdebugFinder for intelligent Xdebug detection
require_once dirname(__DIR__) . '/src/XdebugFinder.php';
use Koriym\XdebugMcp\XdebugFinder;

$action = $argv[1] ?? null;

$projectRoot = dirname(__DIR__);
$mcpServerPath = $projectRoot . '/bin/xdebug-mcp';

// Check PHP version
$phpVersion = PHP_VERSION;
if (version_compare($phpVersion, '8.0.0', '>=')) {
    echo "✅ PHP {$phpVersion}\n";
} else {
    echo "❌ PHP {$phpVersion} (Requires 8.0+)\n";
}

// Check Xdebug status directly
$loaded = extension_loaded('xdebug');
$available = XdebugFinder::isXdebugAvailable();
$detectedPath = XdebugFinder::detectXdebugPath();

$canLoadXdebug = $available;
$zendFlag = $available ? XdebugFinder::getXdebugFlag() : null;

// Check Xdebug version if available
if ($canLoadXdebug) {
    if ($loaded) {
        $version = phpversion('xdebug') ?: 'Unknown';
        if (version_compare($version, '3.0.0', '>=')) {
            echo "⚠️  Xdebug {$version} (always loaded - impacts performance)\n";
        } else {
            echo "⚠️  Xdebug {$version} (always loaded, consider upgrading to 3.0+)\n";
        }
    } else {
        $phpBin = escapeshellcmd(PHP_BINARY);
        $output = [];
        exec(sprintf(
            '%s %s -r "echo phpversion(\'xdebug\');" 2>/dev/null',
            $phpBin,
            $zendFlag
        ), $output);
        if (!empty($output[0])) {
            if (version_compare($output[0], '3.0.0', '>=')) {
                echo "✅ Xdebug {$output[0]} (on-demand)\n";
            } else {
                echo "⚠️  Xdebug {$output[0]} (on-demand, consider upgrading to 3.0+)\n";
            }
        }
    }
} else {
    echo "❌ Xdebug Not available\n";
    XdebugFinder::showInstallationGuidance(false);
}

// Check required PHP extensions (only show if missing)
$requiredExtensions = ['sockets', 'xml', 'json'];
foreach ($requiredExtensions as $ext) {
    if (!extension_loaded($ext)) {
        echo "❌ Extension: {$ext} (Missing)\n";
    }
}

echo "\n";

// Handle installation actions
if ($action === '--install-mcp') {
    echo "🔧 Installing MCP Configuration (Claude Code)\n";
    echo "=============================================\n\n";
    
    $claudeDir = $projectRoot . '/.claude';
    if (!is_dir($claudeDir)) {
        mkdir($claudeDir, 0755, true);
        echo "📁 Created .claude directory\n";
    }
    
    $settingsPath = $claudeDir . '/settings.json';
    $settings = [];
    
    if (file_exists($settingsPath)) {
        $existing = file_get_contents($settingsPath);
        $settings = json_decode($existing, true) ?? [];
        echo "📖 Found existing .claude/settings.json\n";
    }
    
    // Add MCP server configuration
    if (!isset($settings['mcpServers'])) {
        $settings['mcpServers'] = [];
    }
    
    $settings['mcpServers']['xdebug-mcp'] = [
        'command' => $mcpServerPath,
        'args' => [],
        'env' => ['MCP_DEBUG' => '0']
    ];
    
    $jsonContent = json_encode($settings, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
    if (file_put_contents($settingsPath, $jsonContent)) {
        echo "✅ Updated .claude/settings.json\n";
        echo "🎯 Claude Code should now detect xdebug-mcp automatically\n";
    } else {
        echo "❌ Failed to write .claude/settings.json\n";
    }
    
} elseif ($action === '--install-desktop') {
    echo "🔧 Installing Desktop Configuration (Claude Desktop)\n";
    echo "===================================================\n\n";
    
    $home = getenv('HOME') ?: getenv('USERPROFILE') ?: '';
    $platform = PHP_OS_FAMILY;
    $configPaths = [
        'Darwin'  => $home . '/Library/Application Support/Claude/claude_desktop_config.json',
        'Linux'   => $home . '/.config/claude/claude_desktop_config.json',
        'Windows' => (getenv('APPDATA') ? rtrim(getenv('APPDATA'), DIRECTORY_SEPARATOR) : $home . '/AppData/Roaming') . '/Claude/claude_desktop_config.json',
    ];
    $configPath = $configPaths[$platform] ?? null;

    if ($configPath) {
        echo "🖥️  Platform: $platform\n";
        echo "📄 Config path: $configPath\n";
        echo "⚠️  Manual step required:\n\n";
        
        $configExample = [
            "mcpServers" => [
                "xdebug-mcp" => [
                    "command" => $mcpServerPath,
                    "args" => [],
                    "env" => ["MCP_DEBUG" => "0"]
                ]
            ]
        ];
        
        echo "Add this to your Claude Desktop configuration:\n\n";
        echo json_encode($configExample, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n\n";
        echo "Then restart Claude Desktop.\n";
    } else {
        echo "❓ Platform not detected. Please configure manually.\n";
    }
    
}

$hasIssues = !$canLoadXdebug || $loaded || !extension_loaded('sockets') || !extension_loaded('xml');
exit($hasIssues ? 1 : 0);