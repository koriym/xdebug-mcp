#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Xdebug Trace Analyzer - Unified AI Material Builder
 * 
 * Converts large trace files into AI-optimized structured data
 */

// Autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    dirname(__DIR__) . '/autoload.php'
];

foreach ($autoloadPaths as $path) {
    if (file_exists($path)) {
        require_once $path;
        break;
    }
}

use Koriym\XdebugMcp\Profiler\UnifiedAnalyzer;

// CLI argument parsing
$options = [
    'context' => '',
    'summary' => false,
    'compare' => false, 
    'bottlenecks' => 0,
    'search' => '',
    'json' => false,
    'help' => false
];

$traceFiles = [];
$i = 1;

while ($i < $argc) {
    $arg = $argv[$i];
    
    if (str_starts_with($arg, '--context=')) {
        $options['context'] = substr($arg, 10);
    } elseif ($arg === '--summary') {
        $options['summary'] = true;
    } elseif ($arg === '--compare') {
        $options['compare'] = true;
    } elseif (str_starts_with($arg, '--bottlenecks=')) {
        $options['bottlenecks'] = (int)substr($arg, 14);
    } elseif (str_starts_with($arg, '--search=')) {
        $options['search'] = substr($arg, 9);
    } elseif ($arg === '--json') {
        $options['json'] = true;
    } elseif ($arg === '--help' || $arg === '-h') {
        $options['help'] = true;
    } elseif (!str_starts_with($arg, '--')) {
        $traceFiles[] = $arg;
    }
    
    $i++;
}

// Help display
if ($options['help'] || empty($traceFiles)) {
    echo <<<HELP
Xdebug Trace Analyzer - AI Material Builder

Usage: xdebug-analyze [OPTIONS] <trace-file> [trace-file2]

Convert large Xdebug trace files into AI-optimized structured analysis.

Options:
  --context="description"    Context for AI analysis (recommended)
  --summary                  Generate executive summary only  
  --compare                  Compare two trace files
  --bottlenecks=N           Extract top N bottlenecks only
  --search="function"       Search specific function calls
  --json                    Compact JSON output
  --help, -h                Show this help

Examples:
  # Basic analysis with context
  xdebug-analyze /tmp/trace.xt --context="Login failure investigation"
  
  # Executive summary
  xdebug-analyze /tmp/trace.xt --summary
  
  # Compare two executions  
  xdebug-analyze before.xt after.xt --compare
  
  # Extract performance bottlenecks
  xdebug-analyze /tmp/trace.xt --bottlenecks=10
  
  # Search specific functions
  xdebug-analyze /tmp/trace.xt --search="UserController"

Output: AI-optimized JSON with emoji-prefixed categorization for enhanced readability.

HELP;
    exit(0);
}

// Validation
foreach ($traceFiles as $file) {
    if (!file_exists($file)) {
        echo json_encode([
            'error' => "Trace file not found: $file",
            'suggestion' => 'Check file path and permissions'
        ], JSON_PRETTY_PRINT) . "\n";
        exit(1);
    }
}

try {
    // Create analyzer and process
    $analyzer = new UnifiedAnalyzer($traceFiles, $options);
    $result = $analyzer->analyze();
    
    // Output formatted result
    $jsonFlags = $options['json'] ? 0 : JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES;
    echo json_encode($result, $jsonFlags) . "\n";
    
} catch (Exception $e) {
    echo json_encode([
        'error' => $e->getMessage(),
        'trace_files' => $traceFiles,
        'options' => $options
    ], JSON_PRETTY_PRINT) . "\n";
    exit(1);
}