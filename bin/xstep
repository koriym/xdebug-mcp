#!/usr/bin/env php
<?php

declare(strict_types=1);

use Koriym\XdebugMcp\DebugServer;
use Koriym\XdebugMcp\Constants;
use Koriym\XdebugMcp\Exceptions\InvalidLineException;

/**
 * Exception for invalid breakpoint format
 */
class InvalidBreakpointFormatException extends \RuntimeException
{
}

/**
 * Display help information
 */
function showHelp(string $commandName = 'xstep'): void
{
    $isRepl = ($commandName === 'xrepl');

    if ($isRepl) {
        echo "Usage: xrepl [options] [--] command\n";
        echo "\n";
        echo "🔍 Interactive PHP REPL Debugger\n";
        echo "\n";
        echo "PURPOSE:\n";
        echo "  Interactive debugging with breakpoints and variable inspection.\n";
        echo "\n";
        echo "CORE OPTIONS:\n";
        echo "  --break=SPEC            Set breakpoints (file.php:line or file.php:line:condition)\n";
        echo "  --include-vendor=PATTERNS Include vendor packages in trace\n";
        echo "  --help, -h              Show this help\n";
    } else {
        echo "Usage: xstep [options] [--] command\n";
        echo "       xrepl [options] [--] command (for interactive REPL)\n";
        echo "\n";
        echo "🔍 AI-Optimized PHP Step Debugger\n";
        echo "\n";
        echo "PURPOSE:\n";
        echo "  Revolutionary approach to PHP debugging - no var_dump(), no print_r(), no code modification.\n";
        echo "  Provides runtime execution analysis through breakpoints and variable inspection.\n";
        echo "\n";
        echo "COMMANDS:\n";
        echo "  xstep    JSON output mode (AI-optimized, default)\n";
        echo "  xrepl    Interactive REPL mode (human-friendly debugging)\n";
        echo "\n";
        echo "KEY BENEFITS FOR AI DEBUGGING:\n";
        echo "  ✅ Non-invasive: Zero source code modification required\n";
        echo "  ✅ Conditional breakpoints: Break only when specific conditions are met\n";
        echo "  ✅ JSON output: Structured data perfect for AI analysis\n";
        echo "  ✅ Step recording: Capture variable evolution over N execution steps\n";
        echo "  ✅ Context aware: Add descriptions for better AI understanding\n";
        echo "\n";
        echo "CORE OPTIONS:\n";
        echo "  --break=SPEC            Set breakpoints (file.php:line or file.php:line:condition)\n";
        echo "  --steps=N               Record N steps of variable evolution (JSON output)\n";
        echo "  --watch=EXPR            Watch expression, only record steps when value changes\n";
        echo "                          (can be specified multiple times)\n";
        echo "  --context=TEXT          Add contextual description for AI analysis (JSON output)\n";
        echo "  --include-vendor=PATTERNS Include vendor packages in trace\n";
        echo "  --help, -h              Show this help\n";
    }
    echo "\n";
    echo "BREAKPOINT PATTERNS:\n";
    echo "  file.php:15                    # Break at line 15\n";
    echo "  file.php:20:\$user==null       # Break only when \$user is null\n";
    echo "  file1.php:5,file2.php:10       # Multiple breakpoints\n";
    echo "  api.php:42:\$id>100            # Break when \$id exceeds 100\n";
    echo "\n";

    if ($isRepl) {
        echo "EXAMPLES:\n";
        echo "\n";
        echo "  # Interactive debugging session\n";
        echo "  xrepl --break=\"auth.php:20\" -- php main.php\n";
        echo "\n";
        echo "  # Conditional breakpoint\n";
        echo "  xrepl --break=\"user.php:15:\$id==null\" -- php user.php\n";
        echo "\n";
        echo "REPL COMMANDS:\n";
        echo "  s        Step into function\n";
        echo "  o        Step over line\n";
        echo "  out      Step out of function\n";
        echo "  c        Continue execution\n";
        echo "  p <var>  Print variable (e.g., p \$user)\n";
        echo "  bt       Show backtrace\n";
        echo "  l        List source code\n";
        echo "  q        Quit debugger\n";
        echo "\n";
    } else {
        echo "EXAMPLES:\n";
        echo "\n";
        echo "  # AI: JSON output for analysis\n";
        echo "  xstep --break=\"login.php:42\" --context=\"Debug login failure\" -- php login.php\n";
        echo "\n";
        echo "  # AI: Variable state tracking\n";
        echo "  xstep --break=app.php:50 --steps=20 --context=\"Track \$user evolution\" -- php app.php\n";
        echo "\n";
        echo "  # AI: Conditional debugging\n";
        echo "  xstep --break=\"user.php:15:\$id==null\" --context=\"Debug null ID bug\" -- php user.php\n";
        echo "\n";
        echo "  # Human: Interactive REPL\n";
        echo "  xrepl --break=\"auth.php:20\" -- php main.php\n";
        echo "\n";
        echo "OUTPUT FORMATS:\n";
        echo "  xstep: JSON output with complete execution trace and variable states\n";
        echo "  xrepl: Interactive REPL with step control (s, o, c, p, bt, q commands)\n";
        echo "  Benefits: AI can analyze exact variable values at breakpoints without guesswork\n";
        echo "\n";
        echo "📋 JSON SCHEMA RESOURCES (Essential for AI):\n";
        echo "  Schema Definition: https://koriym.github.io/xdebug-mcp/schemas/xstep.json\n";
        echo "  Xdebug Trace Docs: https://xdebug.org/docs/trace\n";
        echo "  Debug Guidelines: https://koriym.github.io/xdebug-mcp/debug_guideline_for_ai.md\n";
        echo "  Forward Trace™ Guide: Complete methodology for AI-powered PHP debugging\n";
        echo "  Schema Note: Combines 'crime scene photo' (breakpoints) + 'surveillance footage' (traces)\n";
        echo "\n";
        echo "AI WORKFLOW INTEGRATION:\n";
        echo "  1. Set contextual breakpoints based on error analysis\n";
        echo "  2. Execute script with breakpoint conditions\n";
        echo "  3. AI analyzes variable states at break points\n";
        echo "  4. AI identifies root cause and suggests fixes\n";
        echo "  5. No source code cleanup needed (no debug statements added)\n";
        echo "\n";
        echo "RECOMMENDED AI PROMPT:\n";
        echo "  'Run xstep --help first, then help me debug this PHP issue using breakpoints'\n";
        echo "\n";
        echo "VS. TRADITIONAL DEBUGGING:\n";
        echo "  ❌ Traditional: Add var_dump(), run, analyze, remove debug code\n";
        echo "  ✅ This tool: Set breakpoints, analyze runtime data, done\n";
        echo "\n";
    }
    exit(0);
}

/**
 * Parse breakpoint specifications
 * Format: file.php:line[:condition][,file2.php:line2,...]
 *
 * @param string $breakSpec Breakpoint specification string
 * @param bool $isDockerCommand If true, skip local file validation (files are in container)
 */
function parseBreakpoints(string $breakSpec, bool $isDockerCommand = false): array
{
    $breakpoints = [];
    $specs = explode(',', $breakSpec);

    foreach ($specs as $spec) {
        $spec = trim($spec);
        if (empty($spec)) continue;

        // Parse file:line[:condition] (supports Windows paths and conditions with colons)
        if (!preg_match('/^(.*):(\d+)(?::(.*))?$/', $spec, $m)) {
            throw new InvalidBreakpointFormatException("Invalid breakpoint format: $spec\n" .
                "Use: file.php:line or file.php:line:condition\n" .
                "Examples:\n" .
                "  - script.php:42\n" .
                "  - script.php:42:\$user==null\n" .
                "  - tests/fake/script.php:42\n" .
                "  - file1.php:10,file2.php:20");
        }
        $file = $m[1];
        $line = (int) $m[2];
        $condition = $m[3] ?? null;

        // For Docker commands, skip local file validation - the path is inside the container
        if ($isDockerCommand) {
            if ($line <= 0) {
                throw new InvalidLineException("Invalid line number: $line in $file");
            }
            $breakpoints[] = [
                'file' => $file,
                'line' => $line,
                'condition' => $condition
            ];
            continue;
        }

        // Try to resolve file path - convert to absolute path for Xdebug
        $resolvedFile = null;
        if (file_exists($file)) {
            // Use realpath to get absolute path
            $resolvedFile = realpath($file);
        } elseif (!str_starts_with($file, '/') && file_exists(getcwd() . '/' . $file)) {
            // Try relative to current working directory
            $resolvedFile = realpath(getcwd() . '/' . $file);
        } else {
            // Try common project paths
            $commonPaths = [
                $file,
                './' . $file,
                'tests/fake/' . basename($file)  // Support common test locations
            ];

            foreach ($commonPaths as $testPath) {
                if (file_exists($testPath)) {
                    $resolvedFile = realpath($testPath);
                    break;
                }
            }
        }

        if (!$resolvedFile) {
            throw new RuntimeException("Breakpoint file not found: $file (searched current dir and common paths)");
        }

        $file = $resolvedFile;

        if ($line <= 0) {
            throw new InvalidLineException("Invalid line number: $line in $file");
        }

        // Validate line number against actual file content (include empty lines)
        $lines = file($file, FILE_IGNORE_NEW_LINES);
        if ($lines === false) {
            throw new InvalidArgumentException("Could not read file: $file");
        }
        $maxLine = count($lines);
        if ($line > $maxLine) {
            throw new InvalidLineException("Line $line does not exist in $file (file has $maxLine lines)");
        }

        $breakpoints[] = [
            'file' => $file,
            'line' => $line,
            'condition' => $condition
        ];
    }

    return $breakpoints;
}

(function () use ($argv){
    require_once __DIR__ . '/autoload.php';

    // Detect if called as xrepl (internal implementation detail)
    $commandName = basename($argv[0]);
    $isRepl = ($commandName === 'xrepl');

    // Show help if no arguments provided
    if (count($argv) === 1) {
        showHelp($commandName);
    }

    // Parse command line arguments
    $breakpointFile = null;
    $breakpointLine = null;
    $breakpoints = [];
    $breakSpec = null;
    $command = [];
    $parseOptions = true;
    $replMode = $isRepl;  // Default to REPL mode if called as xrepl
    $context = null;
    $maxSteps = null;
    $watches = [];

    for ($i = 1; $i < count($argv); $i++) {
        $arg = $argv[$i];

        if ($parseOptions && $arg === '--') {
            $parseOptions = false;
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--break=')) {
            $breakSpec = substr($arg, 8);
            // Defer parsing until we know if it's a Docker command
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--file=')) {
            $breakpointFile = substr($arg, 7);
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--line=')) {
            $breakpointLine = (int)substr($arg, 7);
            continue;
        }

        if ($parseOptions && $arg === '--repl') {
            // Internal flag - not shown in help
            $replMode = true;
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--context=')) {
            $context = substr($arg, 10);
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--steps=')) {
            $maxSteps = (int)substr($arg, 8);
            if ($maxSteps <= 0) {
                throw new RuntimeException("Invalid steps value: $maxSteps (must be positive integer)");
            }
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--watch=')) {
            $watches[] = substr($arg, 8);
            continue;
        }

        if ($parseOptions && str_starts_with($arg, '--include-vendor=')) {
            // This flag is passed directly to prepend_filter.php via auto_prepend_file
            continue;
        }

        if ($parseOptions && ($arg === '--help' || $arg === '-h')) {
            showHelp($commandName);
        }

        if (!$parseOptions || !str_starts_with($arg, '--')) {
            $command[] = $arg;
        }
    }

    // Set modes based on command name
    // xstep (default): traceOnly=true, jsonOutput=true (AI-optimized JSON output)
    // xrepl: traceOnly=false, jsonOutput=false (interactive REPL)
    $traceOnly = !$replMode;
    $jsonOutput = !$replMode;

    // Determine target script and command to execute
    if (empty($command)) {
        showHelp($commandName);
    }

    // Detect Docker/Podman/Kubectl commands
    $isDockerCommand = \Koriym\XdebugMcp\ContainerHelper::isContainerCommand($command);

    // Parse breakpoints now that we know if it's a Docker command
    if ($breakSpec !== null) {
        $breakpoints = parseBreakpoints($breakSpec, $isDockerCommand);
    }

    // Handle legacy format: script.php [breakpoint_file] [break_line]
    if (count($command) >= 1 && !str_contains($command[0], ' ') && file_exists($command[0])) {
        $targetScript = $command[0];
        if (!isset($breakpointFile) && isset($command[1])) {
            $breakpointFile = $command[1];
        }
        if (!isset($breakpointLine) && isset($command[2])) {
            $breakpointLine = (int)$command[2];
        }
    } elseif ($isDockerCommand) {
        // Docker command: find the script as the last argument after 'php'
        $phpIndex = \Koriym\XdebugMcp\ContainerHelper::findPhpCommandIndex($command);
        if ($phpIndex !== false) {
            // Skip PHP options to find the actual script
            $scriptIndex = \Koriym\XdebugMcp\ContainerHelper::findScriptIndex($command, $phpIndex);
            if ($scriptIndex !== false) {
                // Use the script path from Docker command (may be container path like /app/script.php)
                $targetScript = $command[$scriptIndex];
                // For Docker, the script is inside the container - use placeholder for validation
                if (!file_exists($targetScript)) {
                    $targetScript = __DIR__ . '/../tests/fixtures/simple.php';
                }
            } else {
                throw new RuntimeException("Could not find PHP script in Docker command: " . implode(' ', $command));
            }
        } else {
            throw new RuntimeException("Could not find PHP command in Docker command: " . implode(' ', $command));
        }
    } else {
        // New format: complex command after --
        if ($command[0] === 'php' && isset($command[1])) {
            $targetScript = $command[1];
        } else {
            throw new RuntimeException("Could not determine target script from command: " . implode(' ', $command));
        }
    }

    // Validate target script (skip for Docker where script is in container)
    if (!$isDockerCommand && !file_exists($targetScript)) {
        throw new RuntimeException("Target script not found: $targetScript");
    }

    // Validate breakpoint file if specified
    if ($breakpointFile !== null) {
        if (!file_exists($breakpointFile)) {
            throw new RuntimeException("Breakpoint file not found: $breakpointFile");
        }
        if ($breakpointLine === null || $breakpointLine <= 0) {
            throw new RuntimeException("Valid break line number is required when breakpoint file is specified");
        }
    }

    // Use advanced breakpoints if specified, otherwise use legacy format
    if (!empty($breakpoints)) {
        $server = new DebugServer($targetScript, Constants::XDEBUG_DEBUG_PORT, null, [
            'breakpoints' => $breakpoints,
            'command' => $command,
            'traceOnly' => $traceOnly,
            'jsonOutput' => $jsonOutput,
            'context' => $context,
            'maxSteps' => $maxSteps,
            'watches' => $watches,
        ], $jsonOutput);
    } else {
        // For legacy format, only pass command if it's not just the target script
        $options = ['breakpointFile' => $breakpointFile, 'traceOnly' => $traceOnly, 'jsonOutput' => $jsonOutput, 'context' => $context, 'maxSteps' => $maxSteps, 'watches' => $watches];
        if (count($command) > 1 || ($command[0] !== $targetScript)) {
            $options['command'] = $command;
        }
        $server = new DebugServer($targetScript, Constants::XDEBUG_DEBUG_PORT, $breakpointLine, $options, $jsonOutput);
    }
    $server();
})();
