#!/usr/bin/env php
<?php

declare(strict_types=1);

// Load autoloader and get project root
$projectRoot = require __DIR__ . '/autoload.php';

use Koriym\XdebugMcp\Profiler\CachegrindAnalyzer;
use Koriym\XdebugMcp\XdebugRunner;

function showHelp(string $scriptName): void
{
    echo "Usage: $scriptName [--json] [--claude] [--context=TEXT] [--include-vendor=PATTERNS] -- command\n";
    echo "\n";
    echo "⚡ AI-Optimized PHP Performance Profiler with Docker Support\n";
    echo "\n";
    echo "PURPOSE:\n";
    echo "  Profile PHP execution and identify bottlenecks with runtime data.\n";
    echo "\n";
    echo "KEY BENEFITS:\n";
    echo "  ✅ Precision bottleneck identification: Know exactly which functions are slow\n";
    echo "  ✅ Memory usage analysis: Identify memory-hungry operations and leaks\n";
    echo "  ✅ Function call cost breakdown: See time spent in each function call\n";
    echo "  ✅ Docker support: Works with Docker, Podman, and Kubectl containers\n";
    echo "\n";
    echo "CORE OPTIONS:\n";
    echo "  --json                      AI-optimized JSON output\n";
    echo "  --claude                    Auto-analyze profile data with Claude AI\n";
    echo "  --context=TEXT             Add contextual description for AI analysis\n";
    echo "  --include-vendor=PATTERNS  Include matching vendor packages in analysis\n";
    echo "  --help, -h                 Show this help\n";
    echo "\n";
    echo "EXAMPLES:\n";
    echo "\n";
    echo "  # Local PHP execution\n";
    echo "  $scriptName --context=\"Optimize data processing\" -- php process_data.php\n";
    echo "\n";
    echo "  # Docker execution\n";
    echo "  $scriptName --context=\"Docker test\" -- docker compose run --rm php php /app/script.php\n";
    echo "\n";
    echo "  # Docker exec (running container)\n";
    echo "  $scriptName -- docker compose exec -T php php /app/script.php\n";
    echo "\n";
    echo "  # JSON output for tooling\n";
    echo "  $scriptName --json -- php script.php | jq '.bottlenecks'\n";
    echo "\n";
    echo "OUTPUT:\n";
    echo "  Default: Human-readable with KCachegrind suggestions\n";
    echo "  --json: Compact JSON with short keys (file, lines, bottlenecks, etc.)\n";
    echo "  Schema: https://koriym.github.io/xdebug-mcp/schemas/xprofile.json\n";
    echo "\n";
}

// Check for help flag
if (isset($argv[1]) && ($argv[1] === '--help' || $argv[1] === '-h')) {
    showHelp($argv[0]);
    exit(0);
}

// Find '--' separator position
$separatorIndex = array_search('--', $argv);
if ($separatorIndex === false) {
    fwrite(STDERR, "❌ Error: Missing '--' separator\n");
    fwrite(STDERR, "Usage: {$argv[0]} [options] -- command\n");
    exit(1);
}

// Parse flags (before '--')
$ownArgs = array_slice($argv, 1, $separatorIndex - 1);
$jsonOutput = in_array('--json', $ownArgs);
$claudeAnalysis = in_array('--claude', $ownArgs);
$context = null;
$includeVendor = null;

foreach ($ownArgs as $arg) {
    if (str_starts_with($arg, '--context=')) {
        $context = substr($arg, 10);
    } elseif (str_starts_with($arg, '--include-vendor=')) {
        $includeVendor = substr($arg, 17);
    }
}

// Get Xdebug output directory
$xdebugOutputDir = ini_get('xdebug.output_dir') ?: '/tmp';

if (!$jsonOutput) {
    echo "📊 Profiling...\n";
}

// Execute profile using XdebugRunner
try {
    $runner = new XdebugRunner($argv);
    $runner->setMode('profile');
    $runner->setContext($context);
    $runner->setIncludeVendor($includeVendor);

    // Capture output when JSON mode is enabled
    if ($jsonOutput) {
        ob_start();
    }

    $exitCode = $runner->run();

    $scriptOutput = null;
    if ($jsonOutput) {
        $scriptOutput = ob_get_clean();
    }

    if ($exitCode !== 0) {
        exit($exitCode);
    }

    // Get the generated profile file
    $profileFile = $runner->getLatestProfileFile();

    if ($profileFile === null) {
        fwrite(STDERR, "❌ Error: Profile file not found in /tmp\n");
        exit(1);
    }

    $analyzer = new CachegrindAnalyzer();
    $stats = $analyzer->analyze($profileFile, $includeVendor);
    $result = generateEnhancedProfileData($profileFile, $stats, $jsonOutput, $context, $scriptOutput);

    if ($jsonOutput) {
        // AI-optimized compact JSON output
        echo json_encode($result, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
        $profileFile = $result['file'];
    } else {
        // Human-readable output with proper units and formatting
        displayHumanReadableProfile($result);
        $profileFile = $result['profile_file'];
    }

    // Auto-analyze with Claude if requested
    if ($claudeAnalysis) {
        echo "\n🤖 Starting Claude Code analysis...\n";

        $languageOutput = shell_exec('defaults read -g AppleLanguages') ?: '';
        $lang = str_contains($languageOutput, 'ja') ? 'Japanese' : 'English';
        $claudePrompt = "Analyze this Cachegrind profile file for comprehensive code quality: 1) Performance bottlenecks (slow functions, memory usage, execution time), 2) Security concerns (resource exhaustion, timing attacks), 3) Efficiency violations (redundant computations, unnecessary I/O), 4) Architecture principles (separation of concerns, single responsibility). Focus especially on AI/Junior developer code that passes tests but has hidden performance and quality issues: {$profileFile}. Answer in $lang.";

        passthru('claude ' . escapeshellarg($claudePrompt));
        echo "\n";
        echo "🤖 Claude Code analysis completed. 'claude --continue' if you have follow-up questions.\n";
    }
} catch (Exception $e) {
    fwrite(STDERR, "❌ Error: " . $e->getMessage() . "\n");
    exit(1);
}

function generateEnhancedProfileData(string $profileFile, array $stats, bool $jsonOutput = false, ?string $context = null, ?string $scriptOutput = null): array
{
    $fileSize = filesize($profileFile);

    if ($jsonOutput) {
        $result = [
            'specification' => 'https://xdebug.org/docs/profiler',
            'schema' => 'https://koriym.github.io/xdebug-mcp/schemas/xprofile.json',
            'file' => $profileFile,
            'lines' => $stats['total_lines'],
            'size' => $fileSize,
            'functions' => $stats['functions_count'],
            'user_functions' => $stats['user_functions'],
            'internal_functions' => $stats['internal_functions'],
            'calls' => $stats['total_calls'],
            'time_ms' => $stats['execution_time_ms'],
            'memory_mb' => $stats['peak_memory_mb'],
            'file_io' => $stats['file_io_operations'],
            'db_queries' => $stats['database_operations'],
            'bottlenecks' => $stats['bottleneck_functions'],
        ];

        if ($context !== null) {
            $result['context'] = $context;
        }

        if ($scriptOutput !== null && $scriptOutput !== '') {
            $result['output'] = $scriptOutput;
        }

        return $result;
    }

    $result = [
        'profile_file' => $profileFile,
        'total_lines' => $stats['total_lines'],
        'file_size_bytes' => $fileSize,
        'file_size_formatted' => $fileSize > 1024 ? round($fileSize / 1024, 1) . 'KB' : $fileSize . 'B',
        'functions_count' => $stats['functions_count'],
        'user_functions' => $stats['user_functions'],
        'internal_functions' => $stats['internal_functions'],
        'total_calls' => $stats['total_calls'],
        'execution_time_ms' => $stats['execution_time_ms'],
        'peak_memory_mb' => $stats['peak_memory_mb'],
        'file_io_operations' => $stats['file_io_operations'],
        'database_operations' => $stats['database_operations'],
        'bottleneck_functions' => $stats['bottleneck_functions'],
        'optimization_suggestions' => $stats['optimization_suggestions'],
    ];

    if ($context !== null) {
        $result['analysis_context'] = $context;
    }

    return $result;
}

function displayHumanReadableProfile(array $result): void
{
    echo "✅ Profile complete: {$result['profile_file']}\n";
    if (isset($result['analysis_context'])) {
        echo "🎯 Context: {$result['analysis_context']}\n";
    }
    echo "📊 Size: {$result['file_size_formatted']} ({$result['total_lines']} lines)\n";
    echo "📈 Functions: {$result['functions_count']} ({$result['user_functions']} user + {$result['internal_functions']} internal)\n";
    echo "📞 Calls: {$result['total_calls']}\n";

    if ($result['execution_time_ms'] > 0) {
        echo "⏱️ Execution: {$result['execution_time_ms']}ms\n";
    }

    if ($result['peak_memory_mb'] > 0) {
        echo "🧠 Memory: {$result['peak_memory_mb']}MB peak\n";
    }

    // Only show File I/O if there are actual file operations (not just requires)
    if ($result['file_io_operations'] > 0) {
        echo "📂 File I/O: {$result['file_io_operations']} operations\n";
    }

    // Only show Database operations if there are actual DB queries
    if ($result['database_operations'] > 0) {
        echo "🗃️ Database: {$result['database_operations']} queries\n";
    }

    if (!empty($result['bottleneck_functions'])) {
        echo "🎯 Top functions:\n";
        foreach ($result['bottleneck_functions'] as $func) {
            $label = "{$func['function']} ({$func['percentage']}%)";
            if (isset($func['time_ms'])) {
                $label .= " {$func['time_ms']}ms";
            }

            echo "   {$label}\n";
        }
    }

    echo "\n💡 claude \"Analyze {$result['profile_file']}\"\n";
    echo "💡 kcachegrind {$result['profile_file']}\n";
}

exit($exitCode);
