#!/usr/bin/env php
<?php

declare(strict_types=1);

// Load autoloader and get project root
$projectRoot = require __DIR__ . '/autoload.php';

use Koriym\XdebugMcp\XdebugRunner;
use Koriym\XdebugMcp\XdebugTracer;

// Parse command line arguments
function showHelp(string $scriptName): void {
    echo "Usage: $scriptName [--json] [--claude] [--context=TEXT] [--include-vendor=PATTERNS] -- command\n";
    echo "\n";
    echo "📊 AI-Optimized PHP Execution Flow Tracer with Docker Support\n";
    echo "\n";
    echo "PURPOSE:\n";
    echo "  The ultimate alternative to static code analysis - understand what your PHP code\n";
    echo "  ACTUALLY does at runtime. Captures complete execution flow, function calls,\n";
    echo "  parameters, and timing data for AI analysis without any code modification.\n";
    echo "\n";
    echo "KEY BENEFITS FOR AI ANALYSIS:\n";
    echo "  ✅ Runtime reality: See actual execution paths vs theoretical code flow\n";
    echo "  ✅ Function call hierarchy: Complete call stack with parameter values\n";
    echo "  ✅ Performance insights: Identify bottlenecks through execution timing\n";
    echo "  ✅ Bug detection: Spot infinite loops, unexpected paths, wrong parameters\n";
    echo "  ✅ Non-invasive: Zero source code modification - trace any PHP script\n";
    echo "  ✅ Docker support: Works with Docker, Podman, and Kubectl containers\n";
    echo "\n";
    echo "CORE OPTIONS:\n";
    echo "  --json                      Output structured JSON for AI consumption\n";
    echo "  --claude                    Auto-analyze trace data with Claude AI\n";
    echo "  --context=TEXT             Add contextual description for AI analysis\n";
    echo "  --include-vendor=PATTERNS  Include vendor packages in trace analysis\n";
    echo "  --help, -h                 Show this comprehensive help\n";
    echo "\n";
    echo "EXAMPLES:\n";
    echo "\n";
    echo "  # Local PHP execution\n";
    echo "  $scriptName --context=\"Debug login\" -- php login.php\n";
    echo "\n";
    echo "  # Docker execution\n";
    echo "  $scriptName --context=\"Docker test\" -- docker compose run --rm php php /app/script.php\n";
    echo "\n";
    echo "  # Docker exec (running container)\n";
    echo "  $scriptName -- docker compose exec -T php php /app/script.php\n";
    echo "\n";
    echo "  # PHPUnit test analysis\n";
    echo "  $scriptName --context=\"Test analysis\" -- php vendor/bin/phpunit tests/UserTest.php\n";
    echo "\n";
    echo "  # With vendor filtering\n";
    echo "  $scriptName --include-vendor=\"bear/*\" --context=\"BEAR DI\" -- php app.php\n";
    echo "\n";
    echo "OUTPUT FORMATS:\n";
    echo "  Default: Human-readable execution statistics and summary\n";
    echo "  --json: Structured JSON with trace file path and metadata\n";
    echo "  Schema: https://koriym.github.io/xdebug-mcp/schemas/xtrace.json\n";
    echo "\n";
}

// Check for help flag (validation is handled by autoload.php)
if (isset($argv[1]) && ($argv[1] === '--help' || $argv[1] === '-h')) {
    showHelp($argv[0]);
    exit(0);
}

// Find '--' separator position
$separatorIndex = array_search('--', $argv);
if ($separatorIndex === false) {
    fwrite(STDERR, "❌ Error: Missing '--' separator\n");
    fwrite(STDERR, "Usage: xdebug-trace [options] -- command\n");
    exit(1);
}

// Parse flags (before '--')
$ownArgs = array_slice($argv, 1, $separatorIndex - 1);
$jsonOutput = in_array('--json', $ownArgs);
$claudeAnalysis = in_array('--claude', $ownArgs);
$context = null;
$includeVendor = null;

foreach ($ownArgs as $arg) {
    if (str_starts_with($arg, '--context=')) {
        $context = substr($arg, 10);
    } elseif (str_starts_with($arg, '--include-vendor=')) {
        $includeVendor = substr($arg, 17);
    }
}

// Execute trace using XdebugRunner
try {
    $runner = new XdebugRunner($argv);
    $runner->setMode('trace');
    $runner->setContext($context);
    $runner->setIncludeVendor($includeVendor);

    // Capture output when JSON mode is enabled
    if ($jsonOutput) {
        ob_start();
    }

    $exitCode = $runner->run();

    $scriptOutput = null;
    if ($jsonOutput) {
        $scriptOutput = ob_get_clean();
    }

    if ($exitCode !== 0) {
        exit($exitCode);
    }

    // Get the generated trace file
    $traceFile = $runner->getLatestTraceFile();

    if ($traceFile === null) {
        fwrite(STDERR, "❌ Error: Trace file not found in /tmp\n");
        exit(1);
    }

    // Parse trace file for statistics
    $tracer = new XdebugTracer();
    $stats = $tracer->parseTraceFile($traceFile);

    if ($jsonOutput) {
        $result = [
            'file' => $traceFile,
            'lines' => $stats->totalLines,
            'functions' => $stats->getUniqueFunctionCount(),
            'max_depth' => $stats->maxDepth,
            'db_queries' => $stats->dbOperations,
        ];

        if ($context !== null) {
            $result['context'] = $context;
        }

        if ($scriptOutput !== null && $scriptOutput !== '') {
            $result['output'] = $scriptOutput;
        }

        echo json_encode($result, JSON_UNESCAPED_SLASHES) . "\n";
    } else {
        echo "✅ Trace complete: $traceFile\n";
        if ($context !== null) {
            echo "🎯 Context: $context\n";
        }
        echo "📊 {$stats->totalLines} lines generated\n";

        $uniqueFunctionCount = $stats->getUniqueFunctionCount();
        echo "📚 $uniqueFunctionCount unique functions\n";
        echo "🔄 {$stats->maxDepth} max call depth\n";

        if ($stats->dbOperations > 0) {
            echo "🗃️ {$stats->dbOperations} database queries\n";
        }

        echo "\n💡 claude \"Analyze $traceFile\"\n";
    }

    if ($claudeAnalysis) {
        $tracer->analyzeWithClaude($traceFile);
    }
} catch (Exception $e) {
    fwrite(STDERR, "❌ Error: " . $e->getMessage() . "\n");
    exit(1);
}

exit(0);
