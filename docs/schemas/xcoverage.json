{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json",
  "title": "Xdebug Coverage Result",
  "description": "Code coverage data showing only uncovered lines with summary statistics and range-based line grouping.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema reference"
    },
    "coverage_type": {
      "type": "string",
      "enum": ["line"],
      "description": "Coverage analysis type"
    },
    "summary": {
      "type": "object",
      "description": "Coverage statistics summary",
      "properties": {
        "files": { "type": "integer", "description": "Number of files analyzed" },
        "total_lines": { "type": "integer", "description": "Total executable lines" },
        "covered_lines": { "type": "integer", "description": "Lines executed" },
        "uncovered_lines": { "type": "integer", "description": "Lines not executed" },
        "coverage_percent": { "type": "number", "description": "Coverage percentage" }
      },
      "required": ["files", "total_lines", "covered_lines", "uncovered_lines", "coverage_percent"]
    },
    "uncovered": {
      "type": "object",
      "description": "Uncovered lines per file, grouped as ranges. Range semantics (start < end) validated by application.",
      "patternProperties": {
        "^(?:/|[A-Za-z]:\\\\).+\\.php$": {
          "type": "array",
          "description": "Array of line numbers or ranges (e.g., [10, \"15-20\", 25])",
          "items": {
            "oneOf": [
              { "type": "integer", "description": "Single uncovered line" },
              { "type": "string", "pattern": "^[0-9]+-[0-9]+$", "description": "Range of uncovered lines (start-end, validated by app)" }
            ]
          }
        }
      }
    },
    "graphviz_dot_file": {
      "type": "string",
      "description": "Path to generated GraphViz DOT file"
    },
    "visualization_command": {
      "type": "string",
      "description": "Command to generate PNG from DOT file"
    }
  },
  "required": ["$schema", "coverage_type", "summary", "uncovered"],

  "examples": [
    {
      "$schema": "https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json",
      "coverage_type": "line",
      "summary": {
        "files": 3,
        "total_lines": 150,
        "covered_lines": 120,
        "uncovered_lines": 30,
        "coverage_percent": 80.0
      },
      "uncovered": {
        "/path/to/src/UserService.php": ["45-50", 72],
        "/path/to/src/OrderService.php": [15, "20-25"]
      },
      "graphviz_dot_file": "/tmp/xdebug_line_coverage_abc123.dot",
      "visualization_command": "dot -Tpng '/tmp/xdebug_line_coverage_abc123.dot' -o '/tmp/xdebug_line_coverage_abc123.png'"
    }
  ],

  "x-interpretation-guide": {
    "uncovered_format": {
      "single_line": "Integer like 72 means line 72 is uncovered",
      "range": "String like \"45-50\" means lines 45 through 50 are uncovered"
    },
    "ai_analysis_tips": {
      "quick_scan": "Check summary.coverage_percent for overall health",
      "focus_areas": "Look at uncovered ranges to identify untested code blocks",
      "file_reading": "Use Read tool on specific files to understand uncovered lines"
    }
  },

  "links": [
    {
      "rel": "specification",
      "href": "https://xdebug.org/docs/code_coverage",
      "title": "Xdebug Code Coverage Documentation"
    },
    {
      "rel": "function-reference",
      "href": "https://xdebug.org/docs/code_coverage#xdebug_get_code_coverage",
      "title": "xdebug_get_code_coverage() Documentation"
    },
    {
      "rel": "self",
      "href": "https://koriym.github.io/xdebug-mcp/schemas/xcoverage.json",
      "title": "JSON Schema for Xdebug Coverage Results"
    }
  ]
}
