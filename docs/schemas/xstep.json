{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koriym.github.io/xdebug-mcp/schemas/xstep.json",
  "title": "Xdebug Debug Result",
  "description": "Debug state at breakpoints plus execution trace. Breakpoints show 'crime scene photo', trace shows 'surveillance footage'.",
  "type": "object",
  "properties": {
    "breakpoint": {
      "$ref": "#/definitions/breakpoint_reference",
      "description": "Breakpoint shared by all recorded steps, emitted once at the top level (step-recording mode). For multi-breakpoint runs the attribution appears per-step inside each break instead."
    },
    "breaks": {
      "type": "array",
      "description": "Breakpoints hit during execution",
      "items": {
        "$ref": "#/definitions/breakpoint"
      }
    },
    "trace": {
      "$ref": "xtrace.json"
    },
    "context": {
      "type": "string",
      "description": "Optional analysis context"
    }
  },
  "required": ["breaks", "trace"],

  "definitions": {
    "breakpoint": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "description": "Sequential step number"
        },
        "stack": {
          "type": "array",
          "description": "Short stack summary for the current stop",
          "items": {
            "$ref": "#/definitions/stack_frame"
          }
        },
        "breakpoint": {
          "$ref": "#/definitions/breakpoint_reference",
          "description": "Per-step breakpoint attribution for multi-breakpoint runs. In step-recording mode the shared breakpoint is emitted once at the top level instead of here."
        },
        "variables": {
          "type": "object",
          "description": "Full variable snapshot at the breakpoint. Present only on 'full' frames; omitted on 'diff' frames because the values are recoverable from `diff` (each entry's `after`, with removed variables marked change 'removed')."
        },
        "diff": {
          "type": "object",
          "description": "Variable changes since the previous recorded stop. Scalar changes include before/after values; array/object changes may include shallow key diffs.",
          "additionalProperties": {
            "$ref": "#/definitions/variable_diff"
          }
        },
        "recording_type": {
          "type": "string",
          "enum": ["full", "diff"],
          "description": "Present only in step-recording mode (--break + --steps). 'full' marks the first recorded step and contains the complete variable snapshot; 'diff' marks subsequent steps and contains only the changes from the previous step (added, modified, or deleted entries — deletions are encoded as '[DELETED]')."
        },
        "watches": {
          "type": "array",
          "description": "Watch expression evaluation results (present when --watch is used)",
          "items": {
            "type": "object",
            "properties": {
              "expression": {
                "type": "string",
                "description": "The watched PHP expression"
              },
              "value": {
                "type": "string",
                "description": "Current evaluated value"
              },
              "previous": {
                "type": ["string", "null"],
                "description": "Previous value (null for initial step)"
              },
              "reason": {
                "type": "string",
                "enum": ["initial", "changed", "out_of_scope"],
                "description": "Why this watch was recorded"
              }
            },
            "required": ["expression", "value", "reason"]
          }
        }
      },
      "required": ["stack"]
    },
    "breakpoint_reference": {
      "type": "object",
      "description": "Breakpoint attribution for the recorded stop",
      "properties": {
        "id": {
          "type": "string",
          "description": "DBGp breakpoint id, or 'unknown' when no id is available"
        },
        "label": {
          "type": "string",
          "description": "Human-readable breakpoint label"
        }
      },
      "required": ["id", "label"]
    },
    "stack_frame": {
      "type": "object",
      "properties": {
        "function": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer" }
      },
      "required": ["function", "file", "line"]
    },
    "variable_diff": {
      "type": "object",
      "properties": {
        "change": {
          "type": "string",
          "enum": ["added", "changed", "removed"]
        },
        "type": {
          "type": "string",
          "description": "Variable display type, such as int, string, array, or object"
        },
        "before": {
          "type": "string",
          "description": "Previous rendered value when available"
        },
        "after": {
          "type": "string",
          "description": "Current rendered value when available"
        },
        "keys": {
          "$ref": "#/definitions/shallow_key_diff"
        }
      },
      "required": ["change", "type"]
    },
    "shallow_key_diff": {
      "type": "object",
      "properties": {
        "added": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "removed": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "changed": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "before": { "type": "string" },
              "after": { "type": "string" }
            },
            "required": ["before", "after"]
          }
        }
      },
      "required": ["added", "removed", "changed"]
    }
  },

  "links": [
    {
      "rel": "specification",
      "href": "https://xdebug.org/docs/trace",
      "title": "Xdebug Trace Format Documentation"
    },
    {
      "rel": "debug-guide",
      "href": "https://koriym.github.io/xdebug-mcp/debug_guideline_for_ai.md",
      "title": "PHP Xdebug Trace Analysis Guidelines"
    },
    {
      "rel": "self",
      "href": "https://koriym.github.io/xdebug-mcp/schemas/xstep.json",
      "title": "JSON Schema for Xdebug Debug Results"
    }
  ]
}
