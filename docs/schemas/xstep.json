{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koriym.github.io/xdebug-mcp/schemas/xstep.json",
  "title": "Xdebug Debug Result (Token-Optimized)",
  "description": "Debug state at breakpoints plus execution trace. Breakpoints show 'crime scene photo', trace shows 'surveillance footage'.",
  "type": "object",
  "properties": {
    "breaks": {
      "type": "array",
      "description": "Breakpoints hit during execution",
      "items": {
        "$ref": "#/definitions/breakpoint"
      }
    },
    "trace": {
      "$ref": "xtrace.json"
    },
    "context": {
      "type": "string",
      "description": "Optional analysis context"
    }
  },
  "required": ["breaks", "trace"],

  "definitions": {
    "breakpoint": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "description": "Sequential step number"
        },
        "location": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "integer" }
          },
          "required": ["file", "line"]
        },
        "variables": {
          "type": "object",
          "description": "Variable values at breakpoint"
        }
      },
      "required": ["location", "variables"]
    }
  }
}
