{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koriym.github.io/xdebug-mcp/schemas/xback.json",
  "title": "Xdebug Backtrace Result",
  "description": "Stack trace at breakpoint or execution point. Shows call hierarchy.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://koriym.github.io/xdebug-mcp/schemas/xback.json"
    },
    "script": {
      "type": "string",
      "description": "Target PHP script"
    },
    "breakpoint": {
      "type": ["string", "null"],
      "description": "Breakpoint location (file:line)"
    },
    "context": {
      "type": "string",
      "description": "Analysis context"
    },
    "depth": {
      "type": "integer",
      "description": "Maximum stack depth"
    },
    "stack": {
      "type": "array",
      "description": "Call stack frames",
      "items": {
        "type": "object",
        "properties": {
          "level": { "type": "integer" },
          "function": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "class": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"], "enum": ["->", "::", null] }
        },
        "required": ["level", "function", "file", "line"]
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["$schema", "script", "stack", "timestamp"],

  "links": [
    {
      "rel": "specification",
      "href": "https://xdebug.org/docs/stack_trace",
      "title": "Xdebug Stack Trace Documentation"
    },
    {
      "rel": "self",
      "href": "https://koriym.github.io/xdebug-mcp/schemas/xback.json",
      "title": "JSON Schema for Xdebug Backtrace Results"
    }
  ]
}
