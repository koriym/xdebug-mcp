{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koriym.github.io/xdebug-mcp/schemas/xprofile.json",
  "title": "Xdebug Profile Result (Token-Optimized)",
  "description": "Compact profiling data for PHP performance analysis. AI-optimized with short keys and numeric values.",
  "type": "object",
  "properties": {
    "file": {
      "type": "string",
      "description": "Path to the Cachegrind profile file"
    },
    "lines": {
      "type": "integer",
      "description": "Total lines in profile file"
    },
    "size": {
      "type": "integer",
      "description": "Profile file size in bytes"
    },
    "functions": {
      "type": "integer",
      "description": "Number of unique functions profiled"
    },
    "user_fn": {
      "type": "integer",
      "description": "Number of user-defined functions"
    },
    "internal_fn": {
      "type": "integer",
      "description": "Number of internal/built-in functions"
    },
    "calls": {
      "type": "integer",
      "description": "Total function calls recorded"
    },
    "time_ms": {
      "type": "number",
      "description": "Execution time in milliseconds"
    },
    "memory_mb": {
      "type": "number",
      "description": "Peak memory usage in megabytes"
    },
    "file_io": {
      "type": "integer",
      "description": "Number of file I/O operations"
    },
    "db_ops": {
      "type": "integer",
      "description": "Number of database operations"
    },
    "bottlenecks": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Top expensive functions with percentages"
    },
    "context": {
      "type": "string",
      "description": "Optional analysis context"
    },
    "output": {
      "type": "string",
      "description": "Script output if any"
    }
  },
  "required": ["file", "lines", "size", "functions", "calls", "bottlenecks"],

  "examples": [
    {
      "file": "/tmp/cachegrind.out.12345",
      "lines": 5000,
      "size": 125000,
      "functions": 150,
      "user_fn": 80,
      "internal_fn": 70,
      "calls": 3500,
      "time_ms": 45.2,
      "memory_mb": 12.5,
      "file_io": 15,
      "db_ops": 8,
      "bottlenecks": [
        "App\\Repository::findAll (25.3%)",
        "PDO::query (18.7%)",
        "json_encode (8.2%)"
      ]
    }
  ],

  "x-ai-strategies": {
    "analysis_by_size": {
      "small": "size < 100000: Read entire file",
      "medium": "100000-1000000: Focus on top 20 functions",
      "large": "> 1000000: Focus on bottlenecks only"
    }
  }
}
