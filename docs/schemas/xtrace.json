{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://koriym.github.io/xdebug-mcp/schemas/xtrace.json",
  "title": "Xdebug Trace Result",
  "description": "Trace data for PHP debugging. File path and summary - read trace file directly for details.",
  "type": "object",
  "properties": {
    "specification": {
      "type": "string",
      "format": "uri",
      "description": "URL to Xdebug trace documentation"
    },
    "schema": {
      "type": "string",
      "format": "uri",
      "description": "URL to this JSON schema"
    },
    "file": {
      "type": "string",
      "description": "Path to the Xdebug trace file (.xt format)"
    },
    "lines": {
      "type": "integer",
      "description": "Total lines in trace file"
    },
    "functions": {
      "type": "integer",
      "description": "Number of unique functions executed"
    },
    "max_depth": {
      "type": "integer",
      "description": "Maximum function call depth"
    },
    "db_queries": {
      "type": "integer",
      "description": "Database queries detected"
    },
    "context": {
      "type": "string",
      "description": "Optional analysis context"
    },
    "output": {
      "type": "string",
      "description": "Script output if any"
    }
  },
  "required": ["specification", "schema", "file", "lines", "functions", "max_depth", "db_queries"],

  "examples": [
    {
      "specification": "https://xdebug.org/docs/trace",
      "schema": "https://koriym.github.io/xdebug-mcp/schemas/xtrace.json",
      "file": "/tmp/trace.1234567890.xt",
      "lines": 5000,
      "functions": 150,
      "max_depth": 12,
      "db_queries": 25
    }
  ],

  "x-ai-strategies": {
    "reading_strategy": {
      "small": "lines < 1000: Read entire file",
      "medium": "1000-10000: Use Grep to find relevant sections",
      "large": "> 10000: Grep for specific patterns only"
    },
    "search_patterns": {
      "function_calls": "grep 'function_name' trace.xt",
      "return_values": "grep '\\tR\\t' trace.xt",
      "errors": "grep -i 'error\\|exception' trace.xt"
    }
  },

  "x-trace-format": {
    "columns": {
      "0": "Level - call depth",
      "1": "Function ID",
      "2": "Entry/Exit (0/1/R)",
      "3": "Time",
      "4": "Memory",
      "5": "Function name",
      "6": "User-defined (1/0)",
      "7": "Include file",
      "8": "Filename",
      "9": "Line number",
      "10+": "Parameters/return"
    }
  },

  "links": [
    {
      "rel": "specification",
      "href": "https://xdebug.org/docs/trace",
      "title": "Xdebug Trace Format Documentation"
    },
    {
      "rel": "debug-guide",
      "href": "https://koriym.github.io/xdebug-mcp/debug_guideline_for_ai.md",
      "title": "PHP Xdebug Trace Analysis Guidelines"
    },
    {
      "rel": "self",
      "href": "https://koriym.github.io/xdebug-mcp/schemas/xtrace.json",
      "title": "JSON Schema for Xdebug Trace Results"
    }
  ]
}
